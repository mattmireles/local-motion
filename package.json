{
  "name": "local-motion",
  "displayName": "Local Motion",
  "description": "Install and run GGUF coding models locally inside VS Code and Cursor.",
  "version": "0.0.1",
  "publisher": "local-motion",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattmireles/local-motion.git"
  },
  "homepage": "https://github.com/mattmireles/local-motion#readme",
  "bugs": {
    "url": "https://github.com/mattmireles/local-motion/issues"
  },
  "keywords": [
    "local llm",
    "gguf",
    "llama.cpp",
    "cursor",
    "openai-compatible",
    "macos"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:localMotion.open",
    "onCommand:localMotion.automagicalSetup",
    "onCommand:localMotion.retryAutomagicalSetup",
    "onCommand:localMotion.prepareCursor",
    "onCommand:localMotion.stop",
    "onLanguageModelChatProvider:local-motion"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "localMotion.open",
        "title": "Local Motion: Open Setup"
      },
      {
        "command": "localMotion.automagicalSetup",
        "title": "Local Motion: Automagical Setup"
      },
      {
        "command": "localMotion.retryAutomagicalSetup",
        "title": "Local Motion: Retry Automagical Setup"
      },
      {
        "command": "localMotion.prepareCursor",
        "title": "Local Motion: Prepare Cursor"
      },
      {
        "command": "localMotion.stop",
        "title": "Local Motion: Stop Local Model"
      }
    ],
    "configuration": {
      "title": "Local Motion",
      "properties": {
        "localMotion.llamaServerPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to llama-server. If empty, Local Motion searches PATH and Homebrew locations."
        },
        "localMotion.contextTokens": {
          "type": "number",
          "default": 8192,
          "minimum": 2048,
          "maximum": 131072,
          "description": "Context window to request from llama-server."
        },
        "localMotion.parallelRequests": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "Number of parallel requests to allow in llama-server."
        },
        "localMotion.proxyPort": {
          "type": "number",
          "default": 41434,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Preferred localhost port for the Cursor-facing OpenAI proxy. Local Motion falls back to an ephemeral port if this port is already in use."
        },
        "localMotion.defaultModelRepo": {
          "type": "string",
          "default": "yuxinlu1/gemma-4-12B-coder-fable5-composer2.5-v1-GGUF",
          "description": "Default Hugging Face GGUF repository shown in setup and tried first by Automagical Setup before built-in fallback repositories."
        },
        "localMotion.openSetupOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open Local Motion setup automatically once on first startup when no model has been installed."
        },
        "localMotion.runAutomagicalSetupOnFirstStartup": {
          "type": "boolean",
          "default": true,
          "description": "Run Automagical Setup automatically once on first startup when no model has been installed. This may install llama.cpp and download the first compatible GGUF model from the default or fallback repositories."
        },
        "localMotion.resumeAutomagicalSetupOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "After Automagical Setup succeeds, restart the installed local model automatically on future startups without downloading a new model, opening setup, opening Cursor settings, or replacing the clipboard."
        }
      }
    },
    "languageModelChatProviders": [
      {
        "vendor": "local-motion",
        "displayName": "Local Motion"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc -p ./ --noEmit",
    "lint": "eslint src/**/*.ts",
    "test": "npm run compile && node --test tests/*.test.mjs",
    "package": "npm run compile && vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.0.3",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^9.29.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.34.1"
  }
}
